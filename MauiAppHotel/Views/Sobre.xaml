<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre o Aplicativo"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">

            
            <Image Source="dotnet_bot.png"
                   HeightRequest="120"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

          
            <Label Text="MauiAppHotel"
                   FontFamily="Kalam"
                   FontSize="40"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" />

            
            <Frame Padding="20" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Informações do Sistema"
                           FontFamily="Kalam"
                           FontSize="22"
                           TextColor="{StaticResource Primary}"/>

                    <Label Text="• Versão: 1.0.0" FontSize="16" />
                    <Label Text="• Desenvolvedor: Igor Carvalho" FontSize="16" />
                    <Label Text="• Ano de Lançamento: 2026" FontSize="16" />

                    <Label Text="Este aplicativo foi desenvolvido para facilitar o cálculo de diárias e gerenciamento de reservas de hotéis."
                           FontSize="14"
                           TextColor="Gray"
                           Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Botão de Voltar -->
            <Button Text="Voltar"
                    Clicked="OnBotaoVoltarClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>